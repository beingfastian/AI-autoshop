{
  "name": "ai-autoshop",
  "version": "0.1.0",
  "private": true,
  "description": "AI receptionist for auto repair shops - repo root tooling (lint, migrations, test DB)",
  "scripts": {
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:seed": "node scripts/seed.js",
    "test:db:prepare": "node scripts/test-db.js",
    "test": "npm run test:scripts && npm --prefix server test",
    "install:all": "npm install && npm --prefix server install",
    "test:scripts": "jest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/scripts"
    ]
  }
}
