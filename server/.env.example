# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_receptionist
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER=

# URLs
API_BASE_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3000

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=AI Receptionist

# SendGrid dynamic templates (optional, not used by the code yet)
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION_CUSTOMER=
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION_WORKSHOP=
SENDGRID_TEMPLATE_BOOKING_REMINDER=
SENDGRID_TEMPLATE_BOOKING_CANCELLED=

# SMS through Twilio (optional). Email is always on; reminders go out 24h and 2h before.
# With ENABLE_SMS=true the account SID, auth token and a sender are required at startup.
# Use TWILIO_MESSAGING_SERVICE_SID where the country needs an alphanumeric sender ID.
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Timezone (not read by the code yet)
DEFAULT_TIMEZONE=Asia/Karachi

# Security
# Required. Callers of /api/calls and /api/bookings send it in the x-api-key header.
# Generate one with: openssl rand -hex 32
API_KEY=
JWT_SECRET=

# Rate limiting (call and webhook routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS (comma-separated, used when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost:3000
