# Server
PORT=3002
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_receptionist
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=AI Receptionist

# SendGrid dynamic templates (optional, not used by the code yet)
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION_CUSTOMER=
SENDGRID_TEMPLATE_BOOKING_CONFIRMATION_WORKSHOP=
SENDGRID_TEMPLATE_BOOKING_REMINDER=
SENDGRID_TEMPLATE_BOOKING_CANCELLED=

# Service URLs
API_BASE_URL=http://localhost:3002
VOICE_SERVICE_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3000

# Twilio SMS (optional, not used by the code yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notification settings (not read by the code yet)
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
SEND_REMINDER_24H_BEFORE=true
SEND_REMINDER_2H_BEFORE=true

# Timezone
DEFAULT_TIMEZONE=America/New_York

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
