# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_receptionist
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER=

# Service URLs
API_BASE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002

# Security
JWT_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS (comma-separated, used when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost:3000
