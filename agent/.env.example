# Voice agent settings. Copy to agent/.env (git-ignored) and fill in. Never commit real keys.

# LiveKit Cloud project (cloud.livekit.io > Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech in and out (console.deepgram.com)
DEEPGRAM_API_KEY=
# Voice for the receptionist (Deepgram Aura-2 English voices)
DEEPGRAM_VOICE=aura-2-thalia-en
# true = Deepgram may NOT use these calls to train its models (recommended for customer calls)
DEEPGRAM_MIP_OPT_OUT=true

# The LLM (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Our server's voice API: same value as VOICE_AGENT_KEY in server/.env
SERVER_URL=http://localhost:3001
VOICE_AGENT_KEY=

# Browser test calls have no phone numbers; these stand in for them.
# DEMO_SHOP_NUMBER must equal a shop's ai_phone_number in the database.
DEMO_SHOP_NUMBER=+15551112222
DEMO_CALLER_NUMBER=+15559998888
